# ==============================================================================
# REEL STUDIO - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Application Security
SECRET_KEY=reelstudio_development_secret_key_change_in_production_min32chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database Configuration
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/reelstudio
DATABASE_URL_SYNC=postgresql+psycopg2://postgres:postgres@postgres:5432/reelstudio
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=reelstudio

# Redis & Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Object Storage (MinIO / S3)
MINIO_ENDPOINT=minio:9000
MINIO_PUBLIC_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=reel-studio
MINIO_SECURE=false

# Google Gemini AI Configuration
# Get your API key at: https://aistudio.google.com/apikey
# If left empty, Reel Studio will use heuristic detection & provide a setup banner in the UI
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Speech-to-Text (faster-whisper)
# Models: tiny, base, small, medium, large-v3
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_MINIO_URL=http://localhost:9000
NEXT_PUBLIC_DEFAULT_MIN_SCORE=65

# System Settings
MAX_WORKERS=2
CHUNK_DURATION_SECONDS=345
CHUNK_OVERLAP_SECONDS=45
LOG_LEVEL=INFO

# ==============================================================================
# SOCIAL MEDIA AUTO-PUBLISHING (OAUTH & ENCRYPTION)
# ==============================================================================
# Fernet Token Encryption (optional, auto-derived from SECRET_KEY if omitted)
ENCRYPTION_KEY=
ALLOW_MOCK_PUBLISHING=true

# Google / YouTube OAuth (YouTube Data API v3)
# Scopes: https://www.googleapis.com/auth/youtube.upload, https://www.googleapis.com/auth/youtube.readonly
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:8000/api/social/youtube/callback

# Meta (Facebook Page Reels & Instagram Professional Reels)
# Scopes: pages_show_list, pages_read_engagement, pages_manage_posts, instagram_basic, instagram_content_publish
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:8000/api/social/meta/callback

# TikTok (Direct Post API v2)
# Scopes: user.info.basic, video.upload, video.publish
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=http://localhost:8000/api/social/tiktok/callback
