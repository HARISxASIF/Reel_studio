# ==============================================================================
# REEL STUDIO - ENVIRONMENT CONFIGURATION (MULTI-USER SAAS & LOCAL DEV)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE OPERATOR INFRASTRUCTURE (Required for Server & Workers)
# ------------------------------------------------------------------------------
# Application Security & Token Signing (generate with: openssl rand -hex 32)
SECRET_KEY=change_this_to_a_secure_random_32_character_string_for_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Symmetric Credential Encryption (Fernet key for user-supplied API keys & OAuth secrets)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# If left empty, a key will be deterministically derived from SECRET_KEY
ENCRYPTION_KEY=

# SaaS Multi-Tenant Authentication Guard:
# Set to 'false' in production so every user must authenticate with email/password.
# Set to 'true' only for zero-auth local dev.
ALLOW_ANONYMOUS_DEV=false

# Legacy Environment Gemini Key Fallback:
# If 'true', server can use GEMINI_API_KEY as fallback if a user has not configured their personal key.
# If 'false', users without keys run in High-Precision Heuristic Mode.
ALLOW_ENV_GEMINI_KEY_FALLBACK=true

# Public URLs for Production / Vercel:
# BACKEND_PUBLIC_URL: Public HTTPS URL where the FastAPI backend is hosted (e.g., https://api.yourdomain.com)
BACKEND_PUBLIC_URL=http://localhost:8000
# FRONTEND_PUBLIC_URL: Public HTTPS URL where the Vercel Next.js app is hosted (e.g., https://reelstudio.vercel.app)
FRONTEND_PUBLIC_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 2. DATABASE & REDIS INFRASTRUCTURE (Docker Host / Managed Cloud)
# ------------------------------------------------------------------------------
# Async & Sync PostgreSQL URLs
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/reelstudio
DATABASE_URL_SYNC=postgresql+psycopg2://postgres:postgres@postgres:5432/reelstudio
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=reelstudio

# Redis & Celery Worker Broker
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# ------------------------------------------------------------------------------
# 3. OBJECT STORAGE (MinIO / AWS S3 / Cloudflare R2)
# ------------------------------------------------------------------------------
# MINIO_ENDPOINT: Internal endpoint used by API & Celery worker containers (e.g., minio:9000 or s3.us-east-1.amazonaws.com)
MINIO_ENDPOINT=minio:9000
# MINIO_PUBLIC_ENDPOINT: Public endpoint accessed by browser clients for presigned uploads & video streaming
MINIO_PUBLIC_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=reel-studio
MINIO_SECURE=false

# ------------------------------------------------------------------------------
# 4. CELERY WORKER MEDIA ENGINE
# ------------------------------------------------------------------------------
# Speech-to-Text (faster-whisper)
# Models: tiny, base, small, medium, large-v3
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

MAX_WORKERS=2
CHUNK_DURATION_SECONDS=345
CHUNK_OVERLAP_SECONDS=45
LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# 5. FRONTEND (Vercel Deployment Environment Variables)
# ------------------------------------------------------------------------------
# Set this in your Vercel Project Settings -> Environment Variables:
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_DEFAULT_MIN_SCORE=65

# ------------------------------------------------------------------------------
# 6. USER-OWNED CREDENTIALS (Configured by Each User in Settings -> Integrations)
# ------------------------------------------------------------------------------
# NOTE: In Reel Studio SaaS, users enter their OWN Gemini API keys and YouTube OAuth
# credentials inside the web UI at Settings -> Integrations. They are encrypted at
# rest with ENCRYPTION_KEY and isolated per-user.
#
# The environment variables below are optional operator fallbacks for local dev:
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Social OAuth Defaults (Optional operator defaults if not supplied by user)
ALLOW_MOCK_PUBLISHING=false
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:8000/api/social/youtube/callback
